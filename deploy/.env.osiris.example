# Osiris deploy env — copy to .env.osiris on DO1 and fill. NEVER commit the real .env.osiris.
# Phase 1 (vanilla globe) needs NONE of these — keyless feeds work out of the box.

# ── Postgres (Phase 2+: auth/billing/watchlists) ──
POSTGRES_PASSWORD=

# ── RECON scanner backend (Pro feature; separate OSIRIS scanner service) ──
SCANNER_URL=
SCANNER_KEY=

# ── Optional higher-rate data-source keys ──
FIRMS_API_KEY=
AIS_API_KEY=
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
N2YO_API_KEY=

# ── Phase 2+ (added when auth/Stripe/Ozzie land) ──
# NEXTAUTH_SECRET=
# NEXTAUTH_URL=https://osiris.m-i-n-d.ai
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_PRO=
# OSIRIS_MIND_API_KEY=
# OPENROUTER_API_KEY=
# OZZIE_WEBHOOK_URL=         # n8n investigate webhook
# RESEND_API_KEY=
